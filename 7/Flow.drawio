        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;primaryColor&#39;: &#39;#f8fafc&#39;,\n    &#39;primaryTextColor&#39;: &#39;#0f172a&#39;,\n    &#39;primaryBorderColor&#39;: &#39;#64748b&#39;,\n    &#39;lineColor&#39;: &#39;#475569&#39;,\n    &#39;tertiaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;clusterBkg&#39;: &#39;#f8fafc&#39;,\n    &#39;clusterBorder&#39;: &#39;#94a3b8&#39;\n  }\n}}%%\n\nflowchart TB\n\n    %% =========================================================\n    %% LIGHT DRAW.IO-FRIENDLY STYLES\n    %% =========================================================\n\n    classDef originNode fill:#eff6ff,stroke:#0284c7,stroke-width:2px,color:#0c4a6e\n    classDef destNode fill:#ecfdf5,stroke:#10b981,stroke-width:2px,color:#065f46\n    classDef hubNode fill:#eef2ff,stroke:#6366f1,stroke-width:2px,color:#312e81\n    classDef secNode fill:#fef2f2,stroke:#ef4444,stroke-width:2px,color:#991b1b\n    classDef dataNode fill:#faf5ff,stroke:#a855f7,stroke-width:2px,color:#6b21a8\n    classDef sagaNode fill:#fdf2f8,stroke:#ec4899,stroke-width:2px,color:#9d174d\n\n\n    %% =========================================================\n    %% BLOCK 1: ORIGIN HOSPITAL\n    %% =========================================================\n\n    subgraph ORIGIN [\&quot;Block 1: Hospital A (Origin)\&quot;]\n\n        direction LR\n\n        HospA[\&quot;🏥 Hospital A Edge&lt;br/&gt;(Calculates zk-SNARK Consent)\&quot;]:::originNode\n\n    end\n\n\n    %% =========================================================\n    %% BLOCK 2: OMNIHEALTH SAAS HUB\n    %% =========================================================\n\n    subgraph HUB [\&quot;Block 2: OmniHealth SaaS Hub (Saga Orchestration)\&quot;]\n\n        direction TB\n\n\n        %% -----------------------------------------------------\n        %% INGRESS + CONSENT VERIFICATION\n        %% -----------------------------------------------------\n\n        ALB[\&quot;🛡️ Hub ALB &amp; Mirth Connect&lt;br/&gt;(Runs O(1) ZKP Math Verification)\&quot;]:::secNode\n\n\n        %% -----------------------------------------------------\n        %% CLAIM-CHECK STAGING\n        %% -----------------------------------------------------\n\n        subgraph CLAIM_CHECK [\&quot;Claim-Check Staging\&quot;]\n\n            direction LR\n\n            S3Stage[\&quot;📦 S3 Ephemeral Staging&lt;br/&gt;(15MB Bundle)\&quot;]:::dataNode\n\n            SQS[\&quot;📥 SQS FIFO Queue&lt;br/&gt;(MessageGroupId = Patient_ID)\&quot;]:::hubNode\n\n        end\n\n\n        %% -----------------------------------------------------\n        %% SAGA ORCHESTRATOR\n        %% -----------------------------------------------------\n\n        Saga[\&quot;🔄 AWS Step Functions&lt;br/&gt;(The Saga State Machine)\&quot;]:::sagaNode\n\n\n        %% -----------------------------------------------------\n        %% IDEMPOTENCY\n        %% -----------------------------------------------------\n\n        DDB[\&quot;📘 DynamoDB Idempotency Ledger&lt;br/&gt;(Lock: Patient_ID#Correlation_ID)\&quot;]:::dataNode\n\n\n        %% -----------------------------------------------------\n        %% LAMBDA WORKERS\n        %% -----------------------------------------------------\n\n        subgraph WORKERS [\&quot;Single-Purpose Lambda Workers\&quot;]\n\n            direction LR\n\n            WorkerPush[\&quot;⚡ TransferToHospB&lt;br/&gt;(Primary Action)\&quot;]:::hubNode\n\n            WorkerRollback[\&quot;⚡ RollbackHospA&lt;br/&gt;(Compensating Transaction)\&quot;]:::hubNode\n\n            WorkerNotify[\&quot;⚡ NotifySuccess&lt;br/&gt;(Settlement)\&quot;]:::hubNode\n\n        end\n\n\n        %% -----------------------------------------------------\n        %% OUTBOUND NETWORK\n        %% -----------------------------------------------------\n\n        NAT[\&quot;AWS NAT Gateway&lt;br/&gt;(Outbound mTLS + Static IP)\&quot;]:::secNode\n\n\n        %% -----------------------------------------------------\n        %% IMMUTABLE AUDIT RECEIPT\n        %% -----------------------------------------------------\n\n        S3WORM[\&quot;🗄️ S3 WORM Vault&lt;br/&gt;(7-Year Audit Receipt)\&quot;]:::dataNode\n\n    end\n\n\n    %% =========================================================\n    %% BLOCK 3: TARGET HOSPITAL\n    %% =========================================================\n\n    subgraph DESTINATION [\&quot;Block 3: Hospital B (Destination)\&quot;]\n\n        direction LR\n\n        HospB[\&quot;🏥 Hospital B OpenEMR&lt;br/&gt;(Evaluates Idempotency Key)\&quot;]:::destNode\n\n    end\n\n\n    %% =========================================================\n    %% EXECUTION STEPS\n    %% =========================================================\n\n\n    %% ---------------------------------------------------------\n    %% STEP 1: INGRESS + CONSENT\n    %% ---------------------------------------------------------\n\n    HospA -- \&quot;1. POST + [X-ZKP-Consent-Proof]\&quot; --&gt; ALB\n\n    ALB -- \&quot;2a. Stash Payload\&quot; --&gt; S3Stage\n\n    ALB -- \&quot;2b. Push Pointer Ticket\&quot; --&gt; SQS\n\n\n    %% ---------------------------------------------------------\n    %% STEP 2: TRIGGER SAGA\n    %% ---------------------------------------------------------\n\n    SQS -- \&quot;3. Trigger Orchestrator\&quot; --&gt; Saga\n\n    Saga -- \&quot;4. Start: Transfer Step\&quot; --&gt; WorkerPush\n\n\n    %% ---------------------------------------------------------\n    %% STEP 3: IDEMPOTENCY LOCK\n    %% ---------------------------------------------------------\n\n    WorkerPush -- \&quot;5. Acquire Lock (attribute_not_exists)&lt;br/&gt;Prevents Duplicate Records\&quot; --&gt; DDB\n\n    WorkerPush -- \&quot;6. Download Payload\&quot; --&gt; S3Stage\n\n\n    %% ---------------------------------------------------------\n    %% STEP 4: PUSH TO HOSPITAL B\n    %% ---------------------------------------------------------\n\n    WorkerPush -- \&quot;7. Egress via Firewalls\&quot; --&gt; NAT\n\n    NAT -- \&quot;8. HTTP POST + [X-Idempotency-Key]\&quot; --&gt; HospB\n\n\n    %% =========================================================\n    %% STEP 5A: HAPPY PATH\n    %% =========================================================\n\n    HospB -- \&quot;9a. SUCCESS: HTTP 201 Created\&quot; --&gt; NAT\n\n    NAT -.-&gt; WorkerPush\n\n    WorkerPush -. \&quot;10a. Mark Step SUCCESS\&quot; .-&gt; Saga\n\n    Saga -- \&quot;11. Trigger Settlement\&quot; --&gt; WorkerNotify\n\n    WorkerNotify -- \&quot;12. s3:DeleteObject&lt;br/&gt;(Zero PHI)\&quot; --&gt; S3Stage\n\n    WorkerNotify -- \&quot;13. Write SHA-256 Receipt\&quot; --&gt; S3WORM\n\n    WorkerNotify -- \&quot;14. Notify Complete\&quot; --&gt; HospA\n\n\n    %% =========================================================\n    %% STEP 5B: FAILURE PATH\n    %% =========================================================\n\n    HospB -- \&quot;9b. REJECT: HTTP 400 Bad Schema\&quot; --&gt; NAT\n\n    NAT -.-&gt; WorkerPush\n\n    WorkerPush -. \&quot;10b. Throw Exception\&quot; .-&gt; Saga\n\n    Saga -- \&quot;11. Catch Error → Trigger Rollback\&quot; --&gt; WorkerRollback\n\n    WorkerRollback -- \&quot;12. HTTP PATCH (FAILED_REJECTED)&lt;br/&gt;Maintains Global State Consistency\&quot; --&gt; HospA\n\n\n    %% =========================================================\n    %% SUBGRAPH APPEARANCE\n    %% =========================================================\n\n    style ORIGIN fill:#f0f9ff,stroke:#38bdf8,stroke-width:2px,color:#0c4a6e\n\n    style HUB fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#0f172a\n\n    style CLAIM_CHECK fill:#faf5ff,stroke:#c084fc,stroke-width:1px,color:#581c87\n\n    style WORKERS fill:#eef2ff,stroke:#818cf8,stroke-width:1px,color:#312e81\n\n    style DESTINATION fill:#f0fdf4,stroke:#4ade80,stroke-width:2px,color:#14532d&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZsiRdMHjCNgCBeA8GJD_-241">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
