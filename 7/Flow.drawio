        <UserObject label="📱 React Native Mobile App&#xa;(Clinician / Patient UI)" mermaidId="n:App" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#eff6ff;strokeColor=#0284c7;fontColor=#0c4a6e;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="📱 React Native Mobile App&#xa;(Clinician / Patient UI)" id="ZsiRdMHjCNgCBeA8GJD_-205">
