        <UserObject label="⚡ Worker Lambda&#xa;(OPENEMR_POST or IOT_STORE)" mermaidId="n:Worker" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#eef2ff;strokeColor=#6366f1;fontColor=#312e81;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="⚡ Worker Lambda&#xa;(OPENEMR_POST or IOT_STORE)" id="ZsiRdMHjCNgCBeA8GJD_-221">
