        <UserObject label="9. HTTP 201 Created" mermaidId="e:HospALB-&gt;NAT#0" mermaidBaseStyle="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;startArrow=none;endArrow=block;endSize=8;jumpStyle=arc;jumpSize=12;strokeColor=#475569;html=1;fontSize=16;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#0f172a;exitX=0.64;exitY=0;entryX=0.64;entryY=0.99;targetPerimeterSpacing=4;" mermaidBaseValue="9. HTTP 201 Created" id="ZsiRdMHjCNgCBeA8GJD_-240">
