<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="bqMMIFqzOA513gvWUuPQ">
    <mxGraphModel dx="9914" dy="5114" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    %% =========================================================\n    %% PARTICIPANTS\n    %% =========================================================\n\n    actor Doc as Clinician (Browser)\n    participant IoT as Edge Device / Mobile\n\n    box rgb(239, 246, 255) Block 3: Hospital Boundary\n        participant HALB as Hospital ALB\n        participant Cognito as Amazon Cognito\n        participant EMR as OpenEMR (EC2)\n    end\n\n    box rgb(238, 242, 255) Block 2: OmniHealth Hub\n        participant HubGW as Hub API GW / ALB\n        participant HubAuth as Custom Auth / Mirth ZKP\n        participant Queue as Internal Queue (SQS)\n        participant Worker as Hub Lambda Worker\n        participant Cache as Local RAM Cache (Ext)\n    end\n\n\n    %% =========================================================\n    %% FLOW 1: HUMAN TO MACHINE (H2M)\n    %% =========================================================\n\n    rect rgb(248, 250, 252)\n\n        Note over Doc, EMR: FLOW 1: Human-to-Machine (Delegated Auth via OIDC)\n\n        Doc-&gt;&gt;HALB: GET emr.hospital-a.com (No Cookie)\n\n        HALB--&gt;&gt;Doc: HTTP 302 Redirect to Cognito Hosted UI\n\n        Doc-&gt;&gt;Cognito: Enter Credentials + MFA\n\n        Cognito--&gt;&gt;Doc: HTTP 302 Redirect with Auth Code\n\n        Doc-&gt;&gt;HALB: Pass Auth Code\n\n        HALB-&gt;&gt;Cognito: Backchannel: Exchange Code for JWT\n\n        Cognito--&gt;&gt;HALB: Return OIDC JWT (ID &amp; Access Tokens)\n\n        HALB-&gt;&gt;EMR: Forward GET Request + Inject [x-amzn-oidc-data] Header\n\n        Note right of EMR: OpenEMR parses Header,&lt;br/&gt;looks up email, assigns RBAC.\n\n        EMR--&gt;&gt;Doc: HTTP 200 OK (Renders Dashboard)\n\n    end\n\n\n    %% =========================================================\n    %% FLOW 2: MACHINE TO MACHINE INBOUND\n    %% =========================================================\n\n    rect rgb(240, 253, 244)\n\n        Note over IoT, Queue: FLOW 2: M2M Inbound (API Key + ZKP / Custom Auth)\n\n        IoT-&gt;&gt;HubGW: POST /telemetry (PQC TLS 1.3) + API Key + [X-ZKP-Consent-Proof]\n\n        Note right of HubGW: Edge Throttling:&lt;br/&gt;Validates API Key against Tenant Usage Plan\n\n        HubGW-&gt;&gt;HubAuth: Trigger Authorizer (Pass Header)\n\n        Note right of HubAuth: AuthZ Engine runs&lt;br/&gt;O(1) ZKP math verification\n\n        HubAuth--&gt;&gt;HubGW: Return IAM Allow Policy\n\n        HubGW-&gt;&gt;Queue: Payload safely enters VPC\n\n    end\n\n\n    %% =========================================================\n    %% FLOW 3: MACHINE TO MACHINE OUTBOUND\n    %% =========================================================\n\n    rect rgb(254, 242, 242)\n\n        Note over Queue, EMR: FLOW 3: M2M Outbound (Dual-Layer Zero Trust)\n\n        Queue-&gt;&gt;Worker: Trigger Serverless Compute\n\n        Worker-&gt;&gt;Cache: GET localhost:2773 (Secrets Ext)\n\n        Note right of Cache: In-Memory TTL Cache&lt;br/&gt;prevents KMS throttling\n\n        Cache--&gt;&gt;Worker: Returns mTLS Cert + OAuth Bearer Token in &lt; 5ms\n\n\n        %% -----------------------------------------------------\n        %% OSI LAYER 4\n        %% -----------------------------------------------------\n\n        Note over Worker, HALB: OSI Layer 4: Transport AuthN\n\n        Worker-&gt;&gt;HALB: Initiate mTLS Handshake (Presents X.509 Cert)\n\n        HALB--&gt;&gt;Worker: Certificate Verified against Trust Store\n\n\n        %% -----------------------------------------------------\n        %% OSI LAYER 7\n        %% -----------------------------------------------------\n\n        Note over Worker, EMR: OSI Layer 7: Application AuthZ\n\n        Worker-&gt;&gt;HALB: POST /fhir + [Authorization: Bearer Token]\n\n        HALB-&gt;&gt;EMR: Forward Payload\n\n        Note right of EMR: EMR validates Bearer token,&lt;br/&gt;commits data to MySQL.\n\n        EMR--&gt;&gt;Worker: HTTP 201 Created\n\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZsiRdMHjCNgCBeA8GJD_-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
