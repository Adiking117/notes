            <mxGeometry height="120" width="152" x="3779" y="-260" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;primaryColor&#39;: &#39;#f8fafc&#39;,\n    &#39;primaryTextColor&#39;: &#39;#0f172a&#39;,\n    &#39;primaryBorderColor&#39;: &#39;#64748b&#39;,\n    &#39;lineColor&#39;: &#39;#475569&#39;,\n    &#39;tertiaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;clusterBkg&#39;: &#39;#f8fafc&#39;,\n    &#39;clusterBorder&#39;: &#39;#94a3b8&#39;\n  }\n}}%%\n\nflowchart TB\n\n    %% =========================================================\n    %% LIGHT DRAW.IO-FRIENDLY STYLES\n    %% =========================================================\n\n    classDef edgeNode fill:#eff6ff,stroke:#0284c7,stroke-width:2px,color:#0c4a6e\n    classDef hubNode fill:#eef2ff,stroke:#6366f1,stroke-width:2px,color:#312e81\n    classDef destNode fill:#ecfdf5,stroke:#10b981,stroke-width:2px,color:#065f46\n    classDef secNode fill:#fef2f2,stroke:#ef4444,stroke-width:2px,color:#991b1b\n    classDef dataNode fill:#faf5ff,stroke:#a855f7,stroke-width:2px,color:#6b21a8\n    classDef queueNode fill:#f5f3ff,stroke:#8b5cf6,stroke-width:2px,color:#5b21b6\n\n\n    %% =========================================================\n    %% BLOCK 1: EDGE DEVICES\n    %% =========================================================\n\n    subgraph EDGE [\&quot;Block 1: Untrusted Edge (Data Producers)\&quot;]\n\n        direction LR\n\n        BSM[\&quot;🫀 Bedside Monitors&lt;br/&gt;(Task 3: Continuous HL7)\&quot;]:::edgeNode\n\n        IoT[\&quot;💧 IoT Water Sensors&lt;br/&gt;(Task 12: Telemetry Stream)\&quot;]:::edgeNode\n\n    end\n\n\n    %% =========================================================\n    %% BLOCK 2: OMNIHEALTH SAAS HUB\n    %% =========================================================\n\n    subgraph HUB [\&quot;Block 2: OmniHealth SaaS Hub (Asynchronous Pipeline)\&quot;]\n\n        direction TB\n\n        WAF[\&quot;🛡️ Hub ALB &amp; AWS WAF&lt;br/&gt;(Tenant Rate Limits + PQC TLS 1.3)\&quot;]:::secNode\n\n        Mirth[\&quot;⚙️ Mirth Connect (Fargate)&lt;br/&gt;(In-Memory FHIR Translation &amp; Schema Validation)\&quot;]:::hubNode\n\n\n        %% -----------------------------------------------------\n        %% CLAIM-CHECK PATTERN\n        %% -----------------------------------------------------\n\n        subgraph CLAIM_CHECK [\&quot;The Claim-Check Pattern &amp; Logical Sharding\&quot;]\n\n            direction LR\n\n            S3Stage[\&quot;📦 S3 Ephemeral Staging&lt;br/&gt;(Encrypted 15MB Payload)\&quot;]:::dataNode\n\n            SQS[\&quot;📥 Tenant SQS FIFO Queue&lt;br/&gt;(MessageGroupId = Patient_ID)\&quot;]:::queueNode\n\n        end\n\n\n        %% -----------------------------------------------------\n        %% SERVERLESS WORKER\n        %% -----------------------------------------------------\n\n        Worker[\&quot;⚡ Worker Lambda&lt;br/&gt;(OPENEMR_POST or IOT_STORE)\&quot;]:::hubNode\n\n        LocalExt[\&quot;🧠 Lambda Secrets Extension&lt;br/&gt;(RAM Cache: mTLS Certs)\&quot;]:::dataNode\n\n\n        %% -----------------------------------------------------\n        %% ZERO-TRUST EGRESS\n        %% -----------------------------------------------------\n\n        subgraph EGRESS [\&quot;Zero-Trust Egress Routing\&quot;]\n\n            direction LR\n\n            DNS[\&quot;Route 53 DNS Firewall\&quot;]:::secNode\n\n            NetFW[\&quot;AWS Network Firewall\&quot;]:::secNode\n\n            NAT[\&quot;AWS NAT Gateway&lt;br/&gt;(Static IP)\&quot;]:::hubNode\n\n            DNS --&gt; NetFW --&gt; NAT\n\n        end\n\n\n        %% -----------------------------------------------------\n        %% IMMUTABLE AUDIT RECEIPT\n        %% -----------------------------------------------------\n\n        S3WORM[\&quot;🗄️ S3 WORM Vault&lt;br/&gt;(7-Year Object Lock Receipt)\&quot;]:::dataNode\n\n    end\n\n\n    %% =========================================================\n    %% BLOCK 3: TARGET HOSPITALS\n    %% =========================================================\n\n    subgraph TARGETS [\&quot;Block 3: Isolated Tenant Networks\&quot;]\n\n        direction LR\n\n        HospALB[\&quot;🏥 Hospital A/B ALB &amp; OpenEMR&lt;br/&gt;(Verifies mTLS &amp; Static IP)\&quot;]:::destNode\n\n    end\n\n\n    %% =========================================================\n    %% EXECUTION STEPS\n    %% =========================================================\n\n\n    %% ---------------------------------------------------------\n    %% STEP 1: INGRESS\n    %% ---------------------------------------------------------\n\n    BSM -- \&quot;1. Push Raw Data\&quot; --&gt; WAF\n\n    IoT -- \&quot;1. Push Raw Data\&quot; --&gt; WAF\n\n    WAF -- \&quot;2. Route Validated Traffic&lt;br/&gt;+ X-Correlation-ID\&quot; --&gt; Mirth\n\n\n    %% ---------------------------------------------------------\n    %% STEP 2: CLAIM-CHECK + QUEUE\n    %% ---------------------------------------------------------\n\n    Mirth -- \&quot;3a. Stash Heavy Encrypted Payload&lt;br/&gt;(Zero-PHI Messaging)\&quot; --&gt; S3Stage\n\n    Mirth -- \&quot;3b. Push 1KB Pointer Ticket&lt;br/&gt;(Prevents Head-of-Line Block)\&quot; --&gt; SQS\n\n\n    %% ---------------------------------------------------------\n    %% STEP 3: COMPUTE TRIGGER + CREDENTIAL FETCH\n    %% ---------------------------------------------------------\n\n    SQS -- \&quot;4. Trigger Serverless Worker&lt;br/&gt;(MaxConcurrency = 10/50)\&quot; --&gt; Worker\n\n    Worker -- \&quot;5. Fetch Target Credentials (&amp;lt; 5ms)\&quot; --&gt; LocalExt\n\n    Worker -- \&quot;6. Download Heavy Payload into RAM\&quot; --&gt; S3Stage\n\n\n    %% ---------------------------------------------------------\n    %% STEP 4: ZERO-TRUST OUTBOUND ROUTING\n    %% ---------------------------------------------------------\n\n    Worker -- \&quot;7. Outbound HTTPS Request&lt;br/&gt;(Injects Headers &amp; mTLS Certs)\&quot; --&gt; DNS\n\n\n    %% ---------------------------------------------------------\n    %% STEP 5: PUSH TO HOSPITAL\n    %% ---------------------------------------------------------\n\n    NAT -- \&quot;8. HTTP POST /fhir&lt;br/&gt;(mTLS Handshake)\&quot; --&gt; HospALB\n\n\n    %% ---------------------------------------------------------\n    %% STEP 6: RESPONSE\n    %% ---------------------------------------------------------\n\n    HospALB -- \&quot;9. HTTP 201 Created\&quot; --&gt; NAT\n\n    NAT --&gt; Worker\n\n\n    %% ---------------------------------------------------------\n    %% STEP 7: SETTLEMENT + PURGE\n    %% ---------------------------------------------------------\n\n    Worker -- \&quot;10a. Execute s3:DeleteObject&lt;br/&gt;(Permanent Data Destruction)\&quot; --&gt; S3Stage\n\n    Worker -- \&quot;10b. Write SHA-256 Hash Receipt&lt;br/&gt;(Zero PHI Retained)\&quot; --&gt; S3WORM\n\n\n    %% =========================================================\n    %% SUBGRAPH APPEARANCE\n    %% =========================================================\n\n    style EDGE fill:#f0f9ff,stroke:#38bdf8,stroke-width:2px,color:#0c4a6e\n\n    style HUB fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#0f172a\n\n    style CLAIM_CHECK fill:#faf5ff,stroke:#c084fc,stroke-width:1px,color:#581c87\n\n    style EGRESS fill:#fff7ed,stroke:#fb923c,stroke-width:1px,color:#7c2d12\n\n    style TARGETS fill:#f0fdf4,stroke:#4ade80,stroke-width:2px,color:#14532d&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZsiRdMHjCNgCBeA8GJD_-206">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
